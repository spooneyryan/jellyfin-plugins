<Project>
  <!--
    Shared build settings for every project in the repository .
    Plugin projects get the full analyzer set; test projects (name ending in ".Tests") get the
    compiler settings only, as the Bookmarks test project always had. Test conventions such as
    RollForward=Major live in kit/build/TestSupport.props.
  -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <KitRoot>$(RepoRoot)kit\</KitRoot>
  </PropertyGroup>

  <!--
    Jellyfin line to build for: 10.11 (the default: net9.0, Jellyfin.Controller 10.11.5) or 12 (-p:JellyfinTarget=12:
    net10.0, Jellyfin.Controller 12.x, JELLYFIN_12 defined). Directory.Packages.props picks each line's package versions.
    A 12 build restores and builds into obj\j12 and bin\j12, so both lines build in one checkout without one line's
    project.assets.json replacing the other's.
  -->
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">10.11</JellyfinTarget>
    <TargetFramework Condition="'$(JellyfinTarget)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinTarget)' == '12'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(JellyfinTarget)' == '12'">$(DefineConstants);JELLYFIN_12</DefineConstants>
    <BaseIntermediateOutputPath Condition="'$(JellyfinTarget)' == '12'">obj\j12\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(JellyfinTarget)' == '12'">bin\j12\</BaseOutputPath>
    <!-- Neither line compiles the other's generated files (obj\Release beside obj\j12). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject Condition="'$(IsTestProject)' == '' and $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <!-- Lets Moq proxy internal service interfaces in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
