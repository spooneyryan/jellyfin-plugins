<Project>
  <Target Name="KitCheckJellyfinTarget" BeforeTargets="_CheckForInvalidConfigurationAndPlatform;Restore;CollectPackageReferences">
    <Error Condition="'$(JellyfinTarget)' != '10.11'"
           Text="JellyfinTarget '$(JellyfinTarget)' is not supported yet. Only 10.11 builds exist until the Jellyfin 12 port." />
  </Target>
</Project>
