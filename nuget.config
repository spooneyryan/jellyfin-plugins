<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only. Central package management warns (NU1507, an error under
  TreatWarningsAsErrors) when more than one package source is configured, and the machine-wide
  NuGet configuration may list other feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
