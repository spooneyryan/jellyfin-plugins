<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, warnings-as-errors, analyzers and InternalsVisibleTo come from the root Directory.Build.props. -->
  <!-- The shared kit (kit/src) compiles into this assembly. -->
  <Import Project="$(KitRoot)build\Kit.props" />

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.LibraryMaintenance</RootNamespace>
    <!-- Keep equal to build.yaml's version (checked by tests/Repo.Tests). -->
    <Version Condition="'$(JellyfinTarget)' != '12'">1.0.4.0</Version>
    <Version Condition="'$(JellyfinTarget)' == '12'">2.0.0.0</Version>
    <AssemblyVersion Condition="'$(JellyfinTarget)' != '12'">1.0.4.0</AssemblyVersion>
    <AssemblyVersion Condition="'$(JellyfinTarget)' == '12'">2.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(JellyfinTarget)' != '12'">1.0.4.0</FileVersion>
    <FileVersion Condition="'$(JellyfinTarget)' == '12'">2.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- The plan-only build (MovePreviewOnly true) compiles MOVE_PREVIEW_ONLY, which keeps
       Capabilities.CanMove false and leaves out every route and call that changes files, whatever the version. Its default
       and the constant are in MovePreviewOnly.props, which the tests import too, so both compile alike. -->
  <Import Project="..\MovePreviewOnly.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The server provides these at runtime; never ship copies of them with the plugin. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The Dashboard page: its HTML, and the LibraryMaintenanceJs stub (an embedded .js, so the
       server serves it as JavaScript) that imports the AdminScript module the kit builds from Web/admin/js and
       Web/admin/css (Kit.props embeds those). Kit.props also builds the ClientScript from Web/js and Web/css (Move's
       item-menu entry and dialog), which the index.html tag loads while EnableWebUi is on; 1.0 had
       neither. -->
  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\LibraryMaintenanceJs.js" />
    <EmbeddedResource Include="Configuration\LibraryMaintenanceJs.js" />
  </ItemGroup>

</Project>
